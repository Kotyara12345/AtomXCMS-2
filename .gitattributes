# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Explicit rules for source and config files
*.php   text eol=lf
*.html  text eol=lf
*.htm   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.sql   text eol=lf
.htaccess text eol=lf

# Binary files (never touch)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.mp3  binary
*.ttf  binary
*.eot  binary
*.woff binary
*.woff2 binary
*.zip  binary
